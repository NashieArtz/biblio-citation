{% extends 'base.html.twig' %}

{% block title %}Ajouter une citation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
{% endblock %}

{% block body %}
<div class="container">
    <header class="header-page">
        <h1>Ajouter une citation</h1>
        <a href="{{ path('app_citation_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </header>

    <div class="citation-card" style="max-width: 600px; margin: 0 auto;">
        {{ form_start(form) }}
            
            <div style="margin-bottom: 15px;">
                {{ form_row(form.auteur) }}
            </div>
            
            <div style="margin-bottom: 15px;">
                {{ form_row(form.text) }}
            </div>

            <div style="margin-bottom: 15px;">
                {{ form_row(form.publishing_year) }}
            </div>

            <div style="margin-bottom: 15px;">
                {{ form_row(form.source) }}
            </div>

            <div style="margin-bottom: 15px;">
                {{ form_row(form.category) }}
                {{ form_row(form.category_new) }}
            </div>

            <div style="margin-bottom: 15px;">
                {{ form_row(form.universe) }}
                {{ form_row(form.universe_new) }}
            </div>

            <div style="margin-bottom: 15px;">
                {{ form_row(form.tags) }}
                {{ form_row(form.tags_new) }}
            </div>

            <div style="margin-top: 20px;">
                {{ form_widget(form.Submit, {'attr': {'class': 'btn btn-primary'}}) }}
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}